# S3 backend 設定のサンプル（shared 用）。
# これをコピーして backend.hcl を作成し、実値を埋めてから
#   terraform init -backend-config=backend.hcl
# を実行する。
#
# backend.hcl は .gitignore 済み（コミットしない）。認証情報は書かない。
#
# bucket : bootstrap の output "state_bucket_name" の値
#          （daily-health-tracker-tfstate-<AWS_ACCOUNT_ID>）
# key    : dev とは別の state にするため shared/terraform.tfstate

bucket       = "daily-health-tracker-tfstate-<AWS_ACCOUNT_ID>"
key          = "shared/terraform.tfstate"
region       = "ap-northeast-1"
encrypt      = true
use_lockfile = true
