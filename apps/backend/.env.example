DATABASE_URL="postgresql://postgres:postgres@localhost:5432/health_tracker"
PORT=3000
ENABLE_SWAGGER=true
# カンマ区切りで複数オリジン指定可能
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# --- Cognito ---------------------------------------------------------------
# 実値は Terraform の output（cognito_backend_env_suggestion）から取得する。
# issuer は COGNITO_REGION と COGNITO_USER_POOL_ID から導出するため環境変数にしない。
COGNITO_REGION=ap-northeast-1
COGNITO_USER_POOL_ID=ap-northeast-1_example
COGNITO_CLIENT_ID=example-client-id
COGNITO_USERINFO_URL=https://example.auth.ap-northeast-1.amazoncognito.com/oauth2/userInfo
