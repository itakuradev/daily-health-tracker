DATABASE_URL="postgresql://postgres:postgres@localhost:5432/health_tracker"
PORT=3000
ENABLE_SWAGGER=true
# カンマ区切りで複数オリジン指定可能
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"

# --- Cognito ---------------------------------------------------------------
# issuer は COGNITO_REGION と COGNITO_USER_POOL_ID から導出するため環境変数にしない。
#
# ローカル開発では、dev 環境を destroy しても消えない「ローカル開発専用 Cognito」
# （infra/terraform/shared）の値を使う。対応する output は以下（terraform -chdir=infra/terraform/shared output）:
#   COGNITO_REGION       ← cognito_local_region
#   COGNITO_USER_POOL_ID ← cognito_local_user_pool_id
#   COGNITO_CLIENT_ID    ← cognito_local_client_id
#   COGNITO_USERINFO_URL ← cognito_local_userinfo_url（フル URL）
COGNITO_REGION=ap-northeast-1
COGNITO_USER_POOL_ID=ap-northeast-1_example
COGNITO_CLIENT_ID=example-client-id
COGNITO_USERINFO_URL=https://example.auth.ap-northeast-1.amazoncognito.com/oauth2/userInfo
