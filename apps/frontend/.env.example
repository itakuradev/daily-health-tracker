# API のベース URL。
# - ローカル: backend は別ポート(3000)のため絶対 URL を指定する。
# - AWS: フロントと API を同一 CloudFront ドメインで配信する（同一 origin）。
#        CloudFront の URL（https://xxxx.cloudfront.net）を指定する。空にすれば相対 URL でも可。
#        AWS 向けの値は scripts/deploy-frontend-dev.ps1 が Terraform output から設定するため、
#        このファイルを書き換える必要はない。
VITE_API_BASE_URL=http://localhost:3000

# --- Cognito ---------------------------------------------------------------
# 実値は Terraform の output から設定する。
# VITE_COGNITO_DOMAIN はホスト名のみ（https:// やパスは含めない）。
# REDIRECT_* は、ローカルは http://localhost:5173/ 、AWS は https://<CloudFront ドメイン>/ 。
# AWS 向けデプロイでは deploy-frontend-dev.ps1 が output から設定する。
#
# ローカル開発では、dev 環境を destroy しても消えない「ローカル開発専用 Cognito」
# （infra/terraform/shared）の値を使う。対応する output は以下（terraform -chdir=infra/terraform/shared output）:
#   VITE_COGNITO_USER_POOL_ID     ← cognito_local_user_pool_id
#   VITE_COGNITO_CLIENT_ID        ← cognito_local_client_id
#   VITE_COGNITO_DOMAIN           ← cognito_local_domain_host（ホスト名のみ）
#   VITE_COGNITO_REDIRECT_SIGN_IN ← cognito_local_redirect_sign_in
#   VITE_COGNITO_REDIRECT_SIGN_OUT← cognito_local_redirect_sign_out
VITE_COGNITO_USER_POOL_ID=ap-northeast-1_example
VITE_COGNITO_CLIENT_ID=example-client-id
VITE_COGNITO_DOMAIN=example.auth.ap-northeast-1.amazoncognito.com
VITE_COGNITO_REDIRECT_SIGN_IN=http://localhost:5173/
VITE_COGNITO_REDIRECT_SIGN_OUT=http://localhost:5173/
